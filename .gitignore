# Secrets: only *.example files belong in version control.
.env
.env.*
!.env.example
!.env.*.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Django
db.sqlite3
db.sqlite3-journal
staticfiles/
media/
*.log

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
.npm/

# Editors & OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
