SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# DB
# Use whichever port your server listens on (5432 is the PostgreSQL default).
# From Docker, a database on your host machine is host.docker.internal, not localhost.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/payout_db

JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=7
LOGIN_THROTTLE_RATE=10/min

# Browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redirect HTTP to HTTPS when DEBUG=False. Needs a TLS-terminating proxy in
SECURE_SSL_REDIRECT=False

# Weekly payout schedule, for reference - the job runs from system cron:
#   0 0 * * 1 cd /app && python manage.py generate_payouts
PAYOUT_CRON=0 0 * * 1

# Share of simulated payout transfers that fail (0.0-1.0).
PAYOUT_SIMULATED_FAILURE_RATE=0.10

LOG_FORMAT=console
LOG_LEVEL=INFO
